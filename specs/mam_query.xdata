<form_type>
  <name>urn:xmpp:mam:2</name>
  <doc>XEP-0313</doc>
  <desc>Form to query message archives</desc>
  <field var='with'
         type='jid-single'
         label='User JID'/>
  <field var='start'
	 type='text-single'
	 label='Search from the date'/>
  <field var='end'
	 type='text-single'
	 label='Search until the date'/>
  <field var='withtext'
	 type='text-single'
	 label='Search the text (obsolete)'/>
  <field var='after-id'
         type='text-single'
         label='Only results after given id'/>
  <field var='before-id'
         type='text-single'
         label='Only results before given id'/>
  <field var='ids'
         type='list-multi'
         label='List of stanza ids to retrieve'>
    <validate xmlns='http://jabber.org/protocol/xdata-validate' datatype='xs:string'>
  <open/></validate></field>
</form_type>

